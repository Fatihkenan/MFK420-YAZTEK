# PostgreSQL parolasını yerel ortam değişkeni olarak tanımlayın.
# PowerShell örneği:
# $env:ConnectionStrings__PostgreSql="Host=localhost;Port=5432;Database=yaztek;Username=yaztek;Password=PAROLANIZ"
ComprehensionAi__Provider=Ollama
ComprehensionAi__BaseUrl=http://127.0.0.1:11434/
ComprehensionAi__Model=qwen3:4b
ComprehensionAi__TimeoutSeconds=300
ComprehensionAi__NumContext=16384
ComprehensionAi__NumPredict=1536
ComprehensionAi__QuestionBatchSize=2
ComprehensionAi__MaxOutputRetries=2
ComprehensionAi__QualityReviewBatchSize=4
ComprehensionAi__QualityReviewNumPredict=768
ComprehensionAi__EvaluationNumPredict=1536
ComprehensionAi__KeepAlive=30m
